<Window x:Class="Desktop.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Logs (Status History)" Height="500" Width="700"
        WindowStartupLocation="CenterOwner" Background="#f2f3f5">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.04" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Change History Logs" FontSize="20" FontWeight="Bold" Foreground="#222222" Margin="0,0,0,15"/>

                <DataGrid x:Name="LogsDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                          Background="White" BorderThickness="0" RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date/Time" Binding="{Binding ChangedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="140"/>

                        <DataGridTextColumn Header="Workplace" Binding="{Binding WorkplaceName}" Width="*"/>

                        <DataGridTextColumn Header="Status Set To" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
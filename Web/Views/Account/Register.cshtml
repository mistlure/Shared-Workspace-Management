@model API.DTOs.UserRegisterDto

@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-5 col-md-7">
        <div class="card shadow-sm border-primary border-1 rounded-3">
            <div class="card-header bg-white border-bottom border-primary text-center py-4">
                <h3 class="text-primary fw-bold mb-0">Create an Account</h3>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-semibold"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="FirstName" class="form-control border-primary text-dark" placeholder="First Name" />
                                <label asp-for="FirstName" class="text-secondary">First Name</label>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="LastName" class="form-control border-primary text-dark" placeholder="Last Name" />
                                <label asp-for="LastName" class="text-secondary">Last Name</label>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control border-primary text-dark" placeholder="name@example.com" />
                        <label asp-for="Email" class="text-secondary">Email address</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Password" type="password" class="form-control border-primary text-dark" placeholder="Password" />
                        <label asp-for="Password" class="text-secondary">Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg py-2 fw-bold shadow-sm">Sign Up</button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3 border-0">
                <span class="text-muted">Already have an account?</span>
                <a asp-controller="Account" asp-action="Login" class="text-primary text-decoration-none fw-bold ms-1">Log in</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
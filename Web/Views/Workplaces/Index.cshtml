@model IEnumerable<API.DTOs.WorkplaceResponseDto>

@{
    ViewData["Title"] = "Available Desks";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">@ViewData["Title"]</h2>
        <a asp-controller="Workspaces" asp-action="Index" class="btn btn-outline-primary px-4 fw-semibold shadow-sm">
            &larr; Back to Workspaces
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var desk in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-primary border-1 rounded-3">
                        <div class="card-header bg-white border-bottom border-primary text-center py-3">
                            <h5 class="text-primary fw-bold mb-0">@desk.Name</h5>
                        </div>
                        <div class="card-body text-center py-4">
                            @if (desk.CurrentStatus == Domain.Enums.WorkplaceStatus.Available)
                            {
                                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill shadow-sm">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill shadow-sm">Occupied</span>
                            }
                        </div>
                        <div class="card-footer bg-light text-center py-3 border-0">
                            @if (desk.CurrentStatus == Domain.Enums.WorkplaceStatus.Available)
                            {
                                <button type="button" class="btn btn-primary fw-bold px-4 shadow-sm w-100" data-bs-toggle="modal" data-bs-target="#bookModal-@desk.Id">
                                    Book Desk
                                </button>

                                <div class="modal fade" id="bookModal-@desk.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start border-0 shadow-lg">
                                            <div class="modal-header border-bottom border-primary">
                                                <h5 class="modal-title text-primary fw-bold">Confirm Reservation</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <form asp-controller="Workplaces" asp-action="Book" method="post">
                                                <div class="modal-body p-4">
                                                    <input type="hidden" name="workplaceId" value="@desk.Id" />
                                                    <input type="hidden" name="workspaceId" value="@desk.WorkspaceId" />

                                                    @{
                                                        int maxHours = ViewBag.MaxHours ?? 8;
                                                    }

                                                    <div class="mb-4 text-center bg-light rounded-3 py-3 border border-primary border-opacity-25">
                                                        <span class="text-muted small text-uppercase fw-bold tracking-wide">Selected Desk</span>
                                                        <h4 class="text-primary fw-bolder mb-0 mt-1">@desk.Name</h4>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label text-secondary fw-semibold">Duration (Hours)</label>
                                                        <div class="d-flex align-items-center gap-3">
                                                            <input type="range" class="form-range flex-grow-1"
                                                                   min="1" max="@maxHours" step="1" id="durationRange-@desk.Id" value="1"
                                                                   oninput="document.getElementById('durationInput-@desk.Id').value = this.value">

                                                            <input type="number" class="form-control text-center fw-bold text-primary shadow-sm"
                                                                   style="width: 80px; font-size: 1.1rem;"
                                                                   min="1" max="@maxHours" id="durationInput-@desk.Id" name="durationHours" value="1"
                                                                   oninput="
                                                                   if(this.value> @maxHours) this.value = @maxHours;
                                                            if(this.value < 1 && this.value !== '') this.value = 1;
                                                            document.getElementById('durationRange-@desk.Id').value = this.value;
                                                            ">
                                                        </div>
                                                        <div class="d-flex justify-content-between text-muted small mt-1">
                                                            <span>1h</span>
                                                            <span>@maxHours h</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="modal-footer border-0 bg-light">
                                                    <button type="button" class="btn btn-secondary fw-semibold" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Confirm Booking</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-secondary fw-bold px-4 shadow-sm w-100" disabled>Unavailable</button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center text-muted py-5 bg-white rounded-3 shadow-sm border border-1">
                    <p class="fs-5 mb-0">No desks found for this workspace.</p>
                    <p class="small">Add some workplaces via Swagger API!</p>
                </div>
            </div>
        }
    </div>
</div>
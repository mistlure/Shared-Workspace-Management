@model IEnumerable<API.DTOs.WorkspaceResponseDto>

@{
    ViewData["Title"] = "Available Workspaces";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">@ViewData["Title"]</h2>

    <table class="table table-hover table-bordered shadow-sm border-primary">
        <thead class="table-primary">
            <tr>
                <th class="text-primary">Name</th>
                <th class="text-primary">Location</th>
                <th class="text-primary">Price per Hour</th>
                <th class="text-primary">Max Hours</th>
                <th class="text-primary">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle"><strong>@item.Name</strong></td>
                        <td class="align-middle">@item.Location</td>
                        <td class="align-middle">$@item.PricePerHour</td>
                        <td class="align-middle">@item.MaxOccupationHours hrs</td>
                        <td class="align-middle">
                            <a asp-controller="Workplaces" asp-action="Index" asp-route-workspaceId="@item.Id" class="btn btn-primary btn-sm px-3 shadow-sm">View Desks</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        Empty...
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Workspace Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --theme-green: #7ca890;
            --theme-green-dark: #668f78;
            --theme-bg-light: #f9fafb;
            --theme-border: #e1e3e6;
        }

        body {
            background-color: var(--theme-bg-light);
            color: #222;
        }

        .navbar-theme {
            background-color: #ffffff;
            border-bottom: 1px solid var(--theme-border) !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02) !important;
        }

        .ascii-logo {
            font-family: monospace;
            white-space: pre;
            line-height: 1;
            font-size: 10px;
            color: var(--theme-green);
            display: inline-block;
            vertical-align: middle;
            margin-right: 10px;
            transition: color 0.3s;
        }

        .navbar-brand:hover .ascii-logo {
            color: var(--theme-green-dark);
        }

        .nav-link-theme {
            color: #555 !important;
            font-weight: 500;
            transition: color 0.2s;
        }

            .nav-link-theme:hover {
                color: var(--theme-green) !important;
            }

        .user-avatar {
            background-color: var(--theme-green);
            color: white;
            box-shadow: 0 2px 4px rgba(124, 168, 144, 0.2);
        }

        .btn-theme-outline {
            color: var(--theme-green);
            border: 1px solid var(--theme-green);
            transition: all 0.2s;
        }

            .btn-theme-outline:hover {
                background-color: var(--theme-green);
                color: white;
            }

        .footer-theme {
            background-color: #ffffff;
            border-top: 1px solid var(--theme-border) !important;
            color: #818c99;
        }

        .dropdown-menu {
            border: 1px solid var(--theme-border);
            border-radius: 10px;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light navbar-theme mb-4 py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Workspaces" asp-action="Index">
                    <div class="ascii-logo">
                        (\_/)
                        ( •.•)
                        (") (")
                    </div>
                    <span class="fw-bold" style="letter-spacing: -0.5px; color: #333;">Workspace Manager</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-theme" asp-area="" asp-controller="Workspaces" asp-action="Index">Workspaces</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-semibold d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        @User.Identity.Name?[0].ToString().ToUpper()
                                    </div>
                                    <span class="d-none d-md-inline social-text-muted">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2" aria-labelledby="profileDropdown">
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="Profile" asp-action="Index">
                                            <i class="bi bi-person me-2 text-theme" style="font-size: 1.1rem;"></i> My Profile
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" style="opacity: 0.05;"></li>
                                    <li>
                                        <a class="dropdown-item text-danger py-2 d-flex align-items-center" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-theme fw-bold" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-theme-outline ms-lg-3 px-4 fw-semibold btn-sm" style="border-radius: 8px;" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-theme mt-auto py-4">
        <div class="container text-center">
            <span class="small">&copy; 2026 — <span class="fw-semibold" style="color: var(--theme-green);">Shared Workspace Management</span></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>